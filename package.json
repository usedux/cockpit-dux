{
  "name": "cockpit-dux",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cockpit de Projetos DUX — painel dos projetos (Linear em tempo real), levantamento de ferramentas e fechamento semanal.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "build:seed": "node scripts/build-seed.mjs",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --test test/*.test.mjs",
    "dev": "node scripts/build-app.mjs && node dev/server.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^2.0.0",
    "redis": "^4.7.1"
  }
}
